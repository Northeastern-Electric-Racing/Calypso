# Runtime-only image. Expects `bin/calypso` and `bin/simulate` to already be
# built for the target arch by the CI job (see .github/workflows/calypso-build.yml).
# For a self-contained build from source, use the regular `Dockerfile`.

# Must match the builder's glibc: the binaries need GLIBC_2.38, which
# debian:bookworm-slim (2.36) does not have. ubuntu:24.04 is the same
# distro release as the ubuntu-24.04 / ubuntu-24.04-arm build runners.
FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY bin/calypso /usr/local/bin/calypso
COPY bin/simulate /usr/local/bin/simulate

CMD ["simulate"]
