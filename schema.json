{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_CANMsg",
  "type": "array",
  "items": {
    "$ref": "#/$defs/CANMsg"
  },
  "$defs": {
    "BidirMode": {
      "type": "string",
      "enum": [
        "oneshot",
        "broadcast"
      ]
    },
    "CANMsg": {
      "description": "*  Class representing a CAN message",
      "type": "object",
      "properties": {
        "bidir_mode": {
          "$ref": "#/$defs/BidirMode",
          "default": "Broadcast"
        },
        "clients": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          }
        },
        "desc": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetField"
          }
        },
        "id": {
          "type": "string"
        },
        "is_ext": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CANPoint"
          }
        },
        "sim_freq": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "desc",
        "points",
        "fields"
      ]
    },
    "CANPoint": {
      "description": "*  Class representing a CAN point of a NetField",
      "type": "object",
      "properties": {
        "default": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "endianness": {
          "type": [
            "string",
            "null"
          ]
        },
        "formatter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Formatter"
            },
            {
              "type": "null"
            }
          ]
        },
        "ieee754_f32": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "parse": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sim": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sim"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "size"
      ]
    },
    "Formatter": {
      "type": "object",
      "properties": {
        "arg": {
          "type": "number",
          "format": "float"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "arg"
      ]
    },
    "NetField": {
      "description": "*  Class representing a NetField of a CAN message",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "values"
      ]
    },
    "Sim": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "inc_max": {
              "type": "number",
              "format": "float"
            },
            "inc_min": {
              "type": "number",
              "format": "float"
            },
            "max": {
              "type": "number",
              "format": "float"
            },
            "min": {
              "type": "number",
              "format": "float"
            },
            "round": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "inc_min",
            "inc_max"
          ]
        },
        {
          "type": "object",
          "properties": {
            "options": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "float"
                },
                "maxItems": 2,
                "minItems": 2
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "options"
          ]
        }
      ]
    }
  }
}
